// Cloudflare Workers static-assets site (the successor to Cloudflare Pages).
// `npm run deploy` builds dist/ (app + Ogg stems) and runs `wrangler deploy`.
{
  "name": "dream-chamber-remixed",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist"
  },
  "workers_dev": true, // also needed for preview URLs (npm run deploy -- preview)
  "preview_urls": true,
  "routes": [
    { "pattern": "dreamchamberremixed.xyz", "custom_domain": true }
  ]
}
